{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Native dialogs and window interaction; file access is validated by Rust commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm"
  ]
}
