{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tagryn",
  "version": "0.1.0",
  "identifier": "app.tagryn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tagryn",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Your files. Every detail.",
    "longDescription": "An offline workbench for inspecting, comparing and safely editing file metadata.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/runtime/": "runtime/",
      "../docs/THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../docs/DEPENDENCY-LICENSES.txt": "DEPENDENCY-LICENSES.txt",
      "../LICENSE": "LICENSE"
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "tif",
          "tiff",
          "png",
          "webp",
          "heic",
          "heif",
          "avif",
          "dng",
          "cr2",
          "cr3",
          "nef",
          "arw",
          "raf",
          "orf",
          "rw2",
          "pef",
          "xmp",
          "mp4",
          "mov",
          "pdf"
        ],
        "name": "Media and metadata",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English", "German"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Franz Gollhammer"
  }
}
